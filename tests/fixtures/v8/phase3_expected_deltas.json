 "schema": "v8.delta/2",
 "phase": "v8 Phase 3: identity coverage hardening and discovery/execution separation (closures: smart-money identity gate; entry-time identity provenance of smart paper trades)",
 "base": {
  "sha": "82f8d35a80e561384f2e8be0e1399dd4e5adb99b",
  "tree": "06d80f744401589f983ac52298650d182e0c2fa5",
  "golden": "tests/fixtures/v8/legacy_parity_golden_phase3_base.json",
  "golden_note": "main 82f8d35 (Phase 2) on the Phase 3 fixture: the Phase 2 fixture plus the fixture-world known-crypto declaration (alone: no Phase 2 output changes) and the Phase 3 identity cases (MOONX, NEWCOIN, US100S, ADBE, SAMSUNGUSD, SKHYNIX/SKHYNIXUSD, HYUNDAI/HYUNDAIUSD, US10Y, BYD, PRLX)"
 },
 "head_golden": "tests/fixtures/v8/legacy_parity_golden_phase3.json",
 "counterfactual_projection": "exclude_without_execution_identity",
 "rules": {
  "IDENTITY_UNVERIFIED_NO_EXECUTION": "An exposure without positive identity evidence is UNVERIFIED (Phase 2: CRYPTO by default, DEFAULT_CRYPTO). The coin keeps its Phase 2 record (venues, prices, volumes) and tradfi=false in the universe, and loses crypto execution identity: no engine evaluates it.",
  "PARSED_SYMBOL_TRADFI": "On a venue whose symbols name the base asset only (Hyperliquid, Lighter, Variational), a symbol ending in USD yields a parsed candidate; it is tradfi evidence when the candidate is on the tradfi list or an FX pair, or when the candidate ticker has a TRADFI exposure within 20% of the contract's price. Never crypto evidence.",
  "UNVERIFIED_NOT_COUNTED_AS_CRYPTO": "A DEX's count of crypto markets counts only markets admitted with crypto execution identity: unverified markets and markets that became tradfi are no longer counted.",
  "UNVERIFIED_EXPOSURE_NOT_MERGED": "A price-separated UNVERIFIED exposure next to a VERIFIED_CRYPTO exposure of the same ticker is not merged into the crypto coin (contract state UNVERIFIED_EXPOSURE_NOT_ADMITTED), so the price-conflict note for it is not emitted.",
  "UNVERIFIED_LISTED_SEPARATELY": "The radar publishes identity-unverified coins in coverage.unverified, not among the non-crypto (tradfi) exclusions in coverage.tradfi: unknown is not tradfi.",
  "VENUE_FIELD_TRADFI": "A same-venue field the live venue field census showed to be tradfi-only is tradfi evidence: an Aster underlyingSubType in STOCK, ETF, Commodities, Semiconductor, USD1-RWA, or a Variational market name starting 'Swap on ' (scan gh-37782095629-1: 0 such markets in a verified crypto exposure). Tradfi direction only.",
  "SMART_IDENTITY_FIELDS": "Additive only: every smart-money row carries the coin's identity state from the same-scan identity authority (data/v8/identity_authority.json, written by the scanner), and smart.json names the authority it used. On the fixture every smart coin is VERIFIED_CRYPTO, so every signal, information crowd, paper trade and statistic is unchanged; a crowd on a coin without crypto execution identity would be blocked at the source (tests/test_v8_phase3_smart.py).",
  "ANALYZER_SMART_IDENTITY_DEFENSE": "analyze.js (published with the site) accepts a smart-money signal only from a row whose identity is VERIFIED_CRYPTO, and explains an identity-blocked crowd as a note: defense in depth behind the smart.py gate.",
  "SMART_TRADE_IDENTITY_PROVENANCE": "Additive only: every new smart-money paper trade records its entry-time identity proof - identity_state_at_entry, identity_qualified, identity_version, identity_scan_id, identity_decision - from the same-scan identity authority that allowed it, written once and never recomputed. On the fixture both trades (FAKE02 signal, FAKE03 info) are VERIFIED_CRYPTO and qualified; every other trade value (entry, price, stop, hold, kind, id) is unchanged.",
  "SMART_EVIDENCE_BOUNDARY": "Additive only: smart.json accuracy reports the evidence boundary - evidence (qualified vs unqualified trades, open and closed, signal and info) and legacy_unqualified (trades without entry-time identity proof, kept apart, LEGACY_NO_IDENTITY_PROOF). live, live_info and the verdict count qualified trades only; on a fresh fixture run every trade is qualified, so they are unchanged."
 },
